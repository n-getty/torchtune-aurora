#!/usr/bin/env bash
#PBS -N k3_topk_isolation
#PBS -l walltime=03:00:00
#PBS -A AuroraGPT
#PBS -q capacity
#PBS -l select=1
#PBS -l place=scatter
#PBS -l filesystems=flare:home
#PBS -o /lus/flare/projects/ModCon/ngetty/torchtune/experiments/kimi_k3_serving/logs/topk_iso.out
#PBS -e /lus/flare/projects/ModCon/ngetty/torchtune/experiments/kimi_k3_serving/logs/topk_iso.err

# ISOLATE topk FROM EXPERT COUNT.
#
# THE OBSERVATION
# ---------------
#   8-expert  slice (topk=8),  single-node TP=8+EP : maxdiff 0.032-0.094  agree
#   32-expert slice (topk=16), single-node TP=8+EP : maxdiff 0.558-1.272  DIVERGE
#   32-expert slice (topk=16), CROSS-node  TP=16   : maxdiff 0.067-0.425  agree
#
# So DIVERGE appeared the moment the slice carried K3's REAL topk=16. It was
# never tested before: slice_real_k3.py clamps topk to the expert count, so
# every 8-expert run silently ran topk=8.
#
# WHY topk=16 IS SPECIAL, MECHANISTICALLY
# --------------------------------------
# _split_topk_inputs in xpu_moe.py fires ONLY when topk == 16, splitting the
# routing into 2xTopK=8 and summing the two halves' outputs. Every topk=8 run
# skipped that code path entirely. That split is therefore the leading
# candidate -- and note it is K3-specific: the 48B surrogate has topk=8 and has
# always been clean.
#
# THE CONFOUND THIS RESOLVES
# --------------------------
# expert count and topk moved together (8->32 experts forced 8->16 topk), so
# either could explain the DIVERGE. This pins expert count at 16 and varies
# ONLY topk:
#
#   16 experts, topk=8   -> if AGREE, topk is the variable (split implicated)
#   16 experts, topk=16  -> if DIVERGE, confirms it on identical weights
#
# Both slices carry the SAME 16 real experts, so weights, routing capacity and
# memory footprint are held constant. Only the split path differs.
#
# CAUTION: a DIVERGE here is a strong lead, NOT a proven K3 root cause. This
# is a 4-layer fixture, and an earlier DIVERGE in this investigation had to be
# retracted as a probe artifact. Confirm on the real model before acting.

set -o pipefail   # not -u: Lmod's init dereferences ZSH_EVAL_CONTEXT
ROOT=/lus/flare/projects/ModCon/ngetty/torchtune/experiments/kimi_k3_serving
cd "$ROOT" || exit 1

echo "=== topk isolation job=$PBS_JOBID node=$(hostname) $(date -Is) ==="

module load frameworks >/dev/null 2>&1
source /flare/ModCon/ngetty/venvs/kimi-k3-xpu-framework/bin/activate 2>/dev/null

S8=/lus/flare/projects/ModCon/ngetty/k3-slice-4L16E-topk8
S16=/lus/flare/projects/ModCon/ngetty/k3-slice-4L16E-topk16

for spec in "$S8 8" "$S16 16"; do
  set -- $spec
  if [ ! -f "$1/model.safetensors" ]; then
    echo "--- building 16-expert slice topk=$2 ---"
    python3 "$ROOT/slice_real_k3.py" --out "$1" --layers 4 --experts 16 --topk "$2" \
      || { echo "SLICE BUILD FAILED for topk=$2"; exit 1; }
  fi
done

run () {
  local tag="$1"; local slice="$2"; shift 2
  echo; echo "############ $tag (slice=$slice) ############"
  SLICE_OVERRIDE="$slice" timeout 3000 bash "$ROOT/run_slice_suite.sh" "$tag" "$@" || \
    echo "SUITE $tag FAILED (exit $?) -- continuing"
  sleep 20
}

# Same TP, same expert count, same weights. ONLY topk differs.
run k16_topk8  "$S8"  8 --enable-expert-parallel
run k16_topk16 "$S16" 8 --enable-expert-parallel

echo; echo "=== topk isolation done $(date -Is) ==="
grep -H . "$ROOT"/logs/suite_k16_*/VERDICT.txt 2>/dev/null
