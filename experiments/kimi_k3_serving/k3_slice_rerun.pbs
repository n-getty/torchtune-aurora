#!/usr/bin/env bash
#PBS -N k3_slice_rerun
#PBS -l walltime=03:00:00
#PBS -A AuroraGPT
#PBS -q capacity
#PBS -l select=1
#PBS -l place=scatter
#PBS -l filesystems=flare:home
#PBS -o /lus/flare/projects/ModCon/ngetty/torchtune/experiments/kimi_k3_serving/logs/rerun.out
#PBS -e /lus/flare/projects/ModCon/ngetty/torchtune/experiments/kimi_k3_serving/logs/rerun.err

# Clean re-run of the single-node sweep with ALL harness fixes in place.
#
# The first sweep (8741625) was a moving target: five harness defects were
# found and fixed WHILE it ran, and since run_slice_suite.sh is read at
# runtime, each topology saw a different version. Only the last row got
# everything. Those rows are therefore not comparable with each other, which
# defeats the point of a sweep.
#
# Fixes now all present:
#   1. teardown by PID, not `pkill -f api_server` (which self-matched and
#      killed the sweep)
#   2. `set -o pipefail` without -u (Lmod aborts under -u at `module load`)
#   3. CCL_KVS_IFACE=lo (TP>=4 hung in all_reduce during init_device)
#   4. --num-gpu-blocks-override 16 (8 starved -> death at request #30;
#      unset -> OOM at 36.25 GiB)
#   5. reap orphaned VLLM::Worker children (they survive the parent, spin at
#      100% CPU, and hold tiles from the next topology)
#
# WHAT SURVIVES FROM THE FIRST SWEEP: the single-step results for tp1 (agree
# 3/3) and tp2 (agree 2/3 conclusive, 1 inconclusive) completed BEFORE any
# defect triggered in those runs, so they stand. This re-run should reproduce
# them; if it does not, the harness changed something and the earlier numbers
# should be discarded rather than averaged.

set -o pipefail
ROOT=/lus/flare/projects/ModCon/ngetty/torchtune/experiments/kimi_k3_serving
cd "$ROOT" || exit 1

echo "=== clean re-run job=$PBS_JOBID node=$(hostname) start=$(date -Is) ==="
git -C /lus/flare/projects/ModCon/ngetty/torchtune log --oneline -1 2>/dev/null

run () {
  local tag="$1"; shift
  echo
  echo "############ $tag ############"
  timeout 3000 bash "$ROOT/run_slice_suite.sh" "$tag" "$@" || \
    echo "SUITE $tag FAILED (exit $?) -- continuing"
  sleep 20
}

run r_tp1   1
run r_tp2   2
run r_tp4   4
run r_tp4ep 4 --enable-expert-parallel
run r_tp8   8
run r_tp8ep 8 --enable-expert-parallel
# TP=12 REMOVED: vocab 163840 not divisible by 12 (embedding cannot shard).
# Valid TP for K3: 1, 2, 4, 8, 16, 32.

echo
echo "=== re-run done $(date -Is) ==="
grep -H . "$ROOT"/logs/suite_r_*/VERDICT.txt 2>/dev/null
